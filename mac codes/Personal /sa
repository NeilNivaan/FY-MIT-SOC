function seedOrders() {
const items = [];
let n = 1;
const push = (dealerId, statuses, daysAgo) => {
const numItems = 1 + Math.floor(Math.random() * 3);
const picked = [];
let subtotal = 0;
for (let i = 0; i < numItems; i++) {
const p = PRODUCTS[Math.floor(Math.random() * PRODUCTS.length)];
const qty = 2 + Math.floor(Math.random() * 8);
picked.push({ productId: p.id, name: p.name, sku: p.sku, qty, unitPrice: p.price, total: p.price * qty });
subtotal += p.price * qty;
}
const tax = Math.round(subtotal * 0.18);
const total = subtotal + tax;
const id = BMW-ORD-${String(100 + n).padStart(6, "0")}`;
n++;
const date = new Date(Date.now() - daysAgo * 864e5).toISOString();
items.push({
id, dealerId, items: picked, subtotal, tax, total,
status: statuses, date, rejectionReason: null,
});
};
DEALERS.forEach((d, idx) => {
push(d.id, "Delivered", 22 - idx);
push(d.id, "Dispatched", 9);
push(d.id, idx % 3 === 0 ? "Pending Approval" : "Confirmed", 3);
});
push(DEALERS[0].id, "Rejected", 15);
return items.sort((a, b) => new Date(b.date) - new Date(a.date));
}

function seedLedger(dealerId, outstanding) {
const entries = [];
let balance = 0;
const base = outstanding * 0.4;
entries.push({ date: daysAgoISO(60), desc: "Opening balance carried forward", debit: base, credit: 0 });
balance += base;
for (let i = 0; i < 5; i++) {
const debit = Math.round(15000 + Math.random() * 60000);
entries.push({ date: daysAgoISO(50 - i * 9), desc: Invoice — Order dispatched, debit, credit: 0 });
balance += debit;
if (i % 2 === 0) {
const credit = Math.round(debit * 0.6);
entries.push({ date: daysAgoISO(48 - i * 9), desc: "Payment received — NEFT", debit: 0, credit });
balance -= credit;
}
}
const adjust = outstanding - balance;
entries.push({ date: daysAgoISO(2), desc: "Balance adjustment", debit: adjust > 0 ? adjust : 0, credit: adjust < 0 ? -adjust : 0 });
balance = outstanding;
let running = 0;
return entries.map((e) => {
running += e.debit - e.credit;
return { ...e, balance: running };
});
}
function daysAgoISO(d) { return new Date(Date.now() - d * 864e5).toISOString(); }
function fmtDate(iso) { return new Date(iso).toLocaleDateString("en-IN", { day: "2-digit", month: "short", year: "numeric" }); }
function inr(n) { return "₹" + Math.round(n).toLocaleString("en-IN"); }

/* =========================================================================
MOCK SERVICE LAYER
In a real deployment these become HTTP calls to an authenticated backend.
The credit check specifically is written as a pure, isolated function so
it can be lifted verbatim into a server-side handler — the UI never
trusts a client-computed "available credit" to decide the outcome.
========================================================================= */
function serverSideCreditCheck(dealer, orderTotal) {
// Re-reads authoritative dealer.outstanding + dealer.limit — never a
// value carried from the browser's earlier render.
const availableCredit = dealer.limit - dealer.out;
const exposure = dealer.out + orderTotal;
const withinLimit = exposure <= dealer.limit;
return {
withinLimit,
creditLimit: dealer.limit,
currentOutstanding: dealer.out,
orderValue: orderTotal,
availableCredit,
totalExposure: exposure,
amountExceeded: withinLimit ? 0 : exposure - dealer.limit,
};
}

